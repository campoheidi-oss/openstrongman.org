<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OpenStrongman — Coming Soon</title>
<meta name="description" content="An open archive of strongman competition results. Searchable, downloadable, and free.">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f5f4f0;
    --surface: #ffffff;
    --text: #1a1a18;
    --muted: #6b6b67;
    --accent: #1f3a5f;
    --border: #d8d6d0;
    --red: #b03a2e;
    --mono: 'Courier New', Courier, monospace;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    height: 52px;
    display: flex;
    align-items: center;
    background: var(--surface);
  }

  .wordmark {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark span { color: var(--red); }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
  }

  .container {
    max-width: 520px;
    width: 100%;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .description {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 440px;
  }

  .signup-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.6rem;
    display: block;
  }

  .signup-row {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .signup-row:focus-within {
    border-color: var(--accent);
    outline: 2px solid #c2d3e8;
    outline-offset: 1px;
  }

  .signup-row input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.65rem 0.9rem;
    font-size: 14px;
    background: transparent;
    color: var(--text);
    font-family: inherit;
  }

  .signup-row input::placeholder { color: var(--muted); }

  .signup-row button {
    border: none;
    border-left: 1px solid var(--border);
    background: var(--accent);
    color: #fff;
    padding: 0 1.1rem;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .signup-row button:hover { background: #162d4a; }

  .signup-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 0.6rem;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1rem 2rem;
    font-size: 12px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface);
    gap: 1rem;
    flex-wrap: wrap;
  }

  footer a {
    color: var(--muted);
    text-decoration: none;
  }

  footer a:hover { color: var(--text); }

  @media (max-width: 520px) {
    header { padding: 0 1.25rem; }
    main { padding: 2.5rem 1.25rem; align-items: flex-start; }
    footer { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<header>
  <a class="wordmark" href="/"><span>Open</span>Strongman</a>
</header>

<main>
  <div class="container">

    <p class="eyebrow">Coming soon</p>

    <h1>Strongman results,<br><em>open to everyone.</em></h1>

    <p class="description">
      An open database of strongman competition results. Searchable, filterable, and free to download.
    </p>

    <label class="signup-label" for="email-input">Get notified when we launch</label>
    <div class="signup-row">
      <input
        type="email"
        id="email-input"
        placeholder="your@email.com"
        autocomplete="email"
        aria-label="Email address"
      >
      <button type="button" onclick="handleSignup()">Notify me</button>
    </div>
    <p class="signup-note">No spam. One email when the database goes live.</p>

  </div>
</main>

<footer>
  <span>&copy; 2026 OpenStrongman</span>
  <span>Looking for powerlifting results? Visit <a href="https://www.openpowerlifting.org" target="_blank" rel="noopener">OpenPowerlifting.org</a> &mdash; an unaffiliated project.</span>
</footer>

<script>
  function handleSignup() {
    var input = document.getElementById('email-input');
    var email = input.value.trim();
    var valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!valid) {
      input.style.outline = '2px solid #b03a2e';
      input.focus();
      setTimeout(function() { input.style.outline = ''; }, 1800);
      return;
    }
    window.open('https://buttondown.com/OpenStrongman?email=' + encodeURIComponent(email), '_blank');
  }

  document.getElementById('email-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') handleSignup();
  });
</script>

</body>
</html>
