<script>
(function () {
  var EV_LABEL = { none: 'None', minimal: 'Minimal', limited: 'Limited', developing: 'Developing' };
  var PATH_LABEL = { osm: 'OpenStrongman data', field: 'New field needed', external: 'Outside research' };
  var STATUS_LABEL = { open: 'Open', partial: 'Partially addressed' };
  var ISSUE_BASE = 'https://github.com/campoheidi-oss/openstrongman.org/issues/new?title=';

  var refIndex = {};
  var currentFilter = 'all';

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // Turn "{key1} {key2}" runs into one superscript citation like 3,4
  function withCites(text) {
    return esc(text).replace(/(\{[a-z0-9]+\}\s*)+/gi, function (run) {
      var keys = run.match(/\{([a-z0-9]+)\}/gi).map(function (k) { return k.slice(1, -1); });
      var links = keys.map(function (k) {
        var n = refIndex[k];
        return n ? '<a href="#ref-' + n + '">' + n + '</a>' : '';
      }).filter(Boolean).join(',');
      var trailing = /\s$/.test(run) ? ' ' : '';
      return '<sup class="cite">' + links + '</sup>' + trailing;
    });
  }

  function tasksOf(risk) {
    return risk.gaps.reduce(function (acc, g) { return acc.concat(g.tasks); }, []);
  }

  function render(data) {
    data.references.forEach(function (r, i) { refIndex[r.key] = i + 1; });

    var risks = data.risks;
    var allGaps = risks.reduce(function (a, r) { return a.concat(r.gaps); }, []);
    var allTasks = risks.reduce(function (a, r) { return a.concat(tasksOf(r)); }, []);
    var nOsm = allTasks.filter(function (t) { return t.path === 'osm'; }).length;
    var nField = allTasks.filter(function (t) { return t.path === 'field'; }).length;

    var html = '';

    // Stats
    html += '<div class="stats">' +
      stat(risks.length, 'risk areas') +
      stat(allGaps.length, 'knowledge gaps') +
      stat(nOsm, 'tasks OpenStrongman data can take on') +
      stat(nField, 'tasks that need a new data field') +
      '</div>';

    // Filter
    html += '<div class="rm-filter" role="group" aria-label="Filter tasks by path">' +
      '<span class="flabel">Show tasks</span>' +
      chip('all', 'All') + chip('osm', PATH_LABEL.osm) + chip('field', PATH_LABEL.field) + chip('external', PATH_LABEL.external) +
      '<span class="filter-count" id="filter-count" aria-live="polite"></span></div>';

    // Overview grid
    html += '<div class="risk-grid">';
    risks.forEach(function (r) {
      html += '<a class="risk-tile" href="#' + r.id + '" data-risk="' + r.id + '">' +
        '<span class="code">' + r.id + '</span>' +
        '<h3>' + esc(r.title) + '</h3>' +
        '<span class="meta"><span class="ev ev-' + r.evidence + '">' + EV_LABEL[r.evidence] + '</span>' +
        '<span data-tile-count="' + r.id + '">' + r.gaps.length + ' gaps</span></span></a>';
    });
    html += '</div>';

    // Risk details
    html += '<section class="rm-section"><h2>Risk areas</h2>';
    risks.forEach(function (r) {
      html += '<details class="risk" id="' + r.id + '">' +
        '<summary>' +
          '<span class="code">' + r.id + '</span>' +
          '<h3>' + esc(r.title) + '</h3>' +
          '<span class="sum-meta"><span class="ev ev-' + r.evidence + '">Evidence: ' + EV_LABEL[r.evidence] + '</span>' +
          '<span data-sum-count="' + r.id + '">' + r.gaps.length + ' gaps</span><span class="chev" aria-hidden="true"></span></span>' +
        '</summary>' +
        '<div class="risk-body">' +
          '<p class="risk-statement">' + esc(r.statement) + '</p>' +
          '<p class="sub-label">What the evidence says</p>' +
          '<p class="evidence-text">' + withCites(r.summary) + '</p>' +
          '<p class="sub-label">Knowledge gaps</p>';
      r.gaps.forEach(function (g) {
        html += '<div class="gap" id="' + g.id + '" data-risk="' + r.id + '">' +
          '<div class="gap-head">' +
            '<a class="gap-id" href="#' + g.id + '">' + g.id + '</a>' +
            '<span class="gap-q">' + esc(g.question) + '</span>' +
            '<span class="gstatus">' + STATUS_LABEL[g.status] + '</span>' +
          '</div><ul class="task-list">';
        g.tasks.forEach(function (t) {
          html += '<li class="task" data-path="' + t.path + '">' +
            '<span class="path path-' + t.path + '">' + PATH_LABEL[t.path] + '</span>' +
            '<span>' + withCites(t.text) + (t.field ? ' <span class="field-chip" title="Proposed field">' + esc(t.field) + '</span>' : '') + '</span>' +
            '</li>';
        });
        html += '</ul><div class="gap-foot"><a href="' + ISSUE_BASE + encodeURIComponent('Roadmap ' + g.id + ': ') +
          '" target="_blank" rel="noopener">Discuss ' + g.id + ' on GitHub</a></div></div>';
      });
      html += '</div></details>';
    });
    html += '</section>';

    document.getElementById('roadmap-root').innerHTML = html;

    // Proposed fields table (derived from tasks)
    var fields = {};
    risks.forEach(function (r) {
      r.gaps.forEach(function (g) {
        g.tasks.forEach(function (t) {
          if (!t.field) return;
          fields[t.field] = fields[t.field] || [];
          if (fields[t.field].indexOf(g.id) === -1) fields[t.field].push(g.id);
        });
      });
    });
    var rows = Object.keys(fields).sort(function (a, b) { return fields[b].length - fields[a].length || a.localeCompare(b); });
    document.getElementById('fields-body').innerHTML = rows.map(function (f) {
      return '<tr><td>' + esc(f) + '</td><td>' + fields[f].map(function (id) { return '<a href="#' + id + '">' + id + '</a>'; }).join('') + '</td></tr>';
    }).join('');
    document.getElementById('fields-section').hidden = rows.length === 0;

    // Method + references
    var d = new Date(data.lastReviewed + 'T12:00:00');
    var reviewed = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    document.getElementById('method-note').textContent = 'Last reviewed ' + reviewed + '. ' + data.searchNote;
    document.getElementById('ref-list').innerHTML = data.references.map(function (r, i) {
      var links = [];
      if (r.doi) links.push('<a href="https://doi.org/' + esc(r.doi) + '" target="_blank" rel="noopener">doi:' + esc(r.doi) + '</a>');
      if (r.pmid) links.push('<a href="https://pubmed.ncbi.nlm.nih.gov/' + esc(r.pmid) + '/" target="_blank" rel="noopener">PubMed ' + esc(r.pmid) + '</a>');
      if (r.url) links.push('<a href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.url.replace(/^https?:\/\//, '').replace(/\/$/, '')) + '</a>');
      return '<li id="ref-' + (i + 1) + '">' + esc(r.text) + ' ' + links.join(' &middot; ') + '</li>';
    }).join('');

    // Events
    Array.prototype.forEach.call(document.querySelectorAll('.chip-btn'), function (b) {
      b.addEventListener('click', function () { applyFilter(b.getAttribute('data-filter')); });
    });
    Array.prototype.forEach.call(document.querySelectorAll('.risk-tile'), function (a) {
      a.addEventListener('click', function () { openRisk(a.getAttribute('data-risk')); });
    });

    applyFilter('all');
    handleHash();
    window.addEventListener('hashchange', handleHash);
  }

  function stat(n, label) {
    return '<div class="stat"><div class="num">' + n + '</div><div class="lbl">' + label + '</div></div>';
  }

  function chip(key, label) {
    return '<button type="button" class="chip-btn" data-filter="' + key + '" aria-pressed="false">' + esc(label) + '</button>';
  }

  function applyFilter(key) {
    currentFilter = key;
    Array.prototype.forEach.call(document.querySelectorAll('.chip-btn'), function (b) {
      b.setAttribute('aria-pressed', b.getAttribute('data-filter') === key ? 'true' : 'false');
    });

    var shownTasks = 0, totalTasks = 0;
    Array.prototype.forEach.call(document.querySelectorAll('details.risk'), function (det) {
      var shownGaps = 0;
      Array.prototype.forEach.call(det.querySelectorAll('.gap'), function (gap) {
        var visible = 0;
        Array.prototype.forEach.call(gap.querySelectorAll('.task'), function (t) {
          totalTasks++;
          var match = key === 'all' || t.getAttribute('data-path') === key;
          t.hidden = !match;
          if (match) { visible++; shownTasks++; }
        });
        gap.hidden = visible === 0;
        if (visible) shownGaps++;
      });
      det.hidden = shownGaps === 0;
      var id = det.id;
      var total = det.querySelectorAll('.gap').length;
      var label = key === 'all' ? total + ' gaps' : shownGaps + ' of ' + total + ' gaps';
      document.querySelector('[data-sum-count="' + id + '"]').textContent = label;
      document.querySelector('[data-tile-count="' + id + '"]').textContent = label;
      document.querySelector('.risk-tile[data-risk="' + id + '"]').classList.toggle('dim', shownGaps === 0);
    });

    document.getElementById('filter-count').textContent = key === 'all'
      ? totalTasks + ' tasks'
      : 'Showing ' + shownTasks + ' of ' + totalTasks + ' tasks';
  }

  function openRisk(id) {
    var det = document.getElementById(id);
    if (det && det.tagName === 'DETAILS') {
      if (det.hidden) applyFilter('all');
      det.open = true;
    }
  }

  function handleHash() {
    var id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    var el = document.getElementById(id);
    if (!el) return;
    var det = el.tagName === 'DETAILS' ? el : el.closest('details.risk');
    if (!det) return;
    if (det.hidden || el.hidden) applyFilter('all');
    det.open = true;
    requestAnimationFrame(function () { el.scrollIntoView({ block: 'start' }); });
  }

  fetch('roadmap.json', { cache: 'no-cache' })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(render)
    .catch(function () {
      document.getElementById('roadmap-root').innerHTML =
        '<p class="load-error">The roadmap data could not be loaded. If you are viewing this file directly from your computer, open it through a local web server or the live site instead.</p>';
    });
})();
</script>

</body>
</html>
