<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OpenStrongman - Research Roadmap</title>
<meta name="description" content="What strongman science knows, what it does not, and which open questions the OpenStrongman dataset can help answer. Modeled on NASA's Human Research Roadmap.">
<link rel="stylesheet" href="style.css">
<style>
  :root {
    --amber: #8a5a00;
    --amber-light: #fbf1dc;
  }

  .rm-wrap { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }

  .rm-section { margin-bottom: 2.5rem; }

  .rm-section > h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .rm-section p.lede {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.75;
    max-width: 720px;
    margin-bottom: 0.75rem;
  }

  .rm-section a { color: var(--accent-mid); }

  sup.cite { font-size: 10px; line-height: 0; vertical-align: super; font-weight: 600; }
  sup.cite a { color: var(--accent-mid); text-decoration: none; }
  sup.cite a:hover { text-decoration: underline; }

  /* ── HOW IT WORKS ── */
  .structure {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 1.25rem 0 0.5rem;
    position: relative;
  }

  .structure-step {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem 1.1rem;
    position: relative;
  }

  .structure-step:first-child { border-radius: 8px 0 0 8px; }
  .structure-step:last-child { border-radius: 0 8px 8px 0; }
  .structure-step + .structure-step { border-left: none; }

  .structure-step + .structure-step::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 50%;
    width: 12px;
    height: 12px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    transform: translateY(-50%) rotate(45deg);
  }

  .structure-step .step-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.3rem;
  }

  .structure-step h3 { font-size: 14px; font-weight: 700; margin-bottom: 0.3rem; }
  .structure-step p { font-size: 12.5px; color: var(--muted); line-height: 1.55; }

  /* ── KEY ── */
  .key-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1rem;
    align-items: start;
    font-size: 12px;
    color: var(--muted);
  }

  .key-box .key-head {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--faint);
    text-transform: uppercase;
    padding-top: 3px;
    white-space: nowrap;
  }

  .key-row { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .key-item { display: flex; align-items: center; gap: 0.4rem; }

  /* ── BADGES ── */
  .ev, .path, .gstatus, .field-chip {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .ev-none { background: var(--red-light); color: var(--red); }
  .ev-minimal, .ev-limited { background: var(--amber-light); color: var(--amber); }
  .ev-developing { background: var(--green-light); color: var(--green); }

  .path-osm { background: var(--green-light); color: var(--green); }
  .path-field { background: var(--accent-light); color: var(--accent); }
  .path-external { background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); padding: 1px 6px; }

  .gstatus { font-family: var(--mono); font-weight: 500; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); padding: 0; }

  .field-chip { font-family: var(--mono); font-weight: 500; background: var(--surface); border: 1px dashed #b7c7dc; color: var(--accent); padding: 1px 6px; }

  /* ── STATS ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    margin-bottom: 1.5rem;
  }

  .stat { padding: 0.9rem 1rem; }
  .stat + .stat { border-left: 1px solid var(--border); }
  .stat .num { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .stat .lbl { font-size: 11.5px; color: var(--muted); line-height: 1.4; }

  /* ── FILTER ── */
  .rm-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .rm-filter .flabel {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 0.25rem;
  }

  .chip-btn {
    font-family: var(--sans);
    font-size: 12px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s, background 0.1s;
  }

  .chip-btn:hover { color: var(--text); border-color: var(--faint); }
  .chip-btn[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .chip-btn:focus-visible, summary:focus-visible, .risk-tile:focus-visible { outline: 2px solid var(--accent-mid); outline-offset: 2px; }

  .filter-count { font-size: 12px; color: var(--faint); margin-left: auto; }

  /* ── OVERVIEW GRID ── */
  .risk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .risk-tile {
    display: block;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem 1rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.12s, transform 0.12s;
  }

  .risk-tile:hover { border-color: var(--accent-mid); }
  .risk-tile.dim { opacity: 0.4; }

  .risk-tile .code { font-family: var(--mono); font-size: 11px; color: var(--red); letter-spacing: 0.06em; }
  .risk-tile h3 { font-size: 14px; font-weight: 600; line-height: 1.35; margin: 0.2rem 0 0.6rem; }
  .risk-tile .meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font-size: 11.5px; color: var(--muted); }

  /* ── RISK DETAIL ── */
  details.risk {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 0.75rem;
    scroll-margin-top: calc(var(--nav-h) + 12px);
  }

  details.risk[hidden] { display: none; }

  details.risk > summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.25rem 0.85rem;
    align-items: center;
  }

  details.risk > summary::-webkit-details-marker { display: none; }

  details.risk > summary .code { font-family: var(--mono); font-size: 12px; color: var(--red); letter-spacing: 0.06em; min-width: 3.4rem; }
  details.risk > summary h3 { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  details.risk > summary .sum-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 12px; color: var(--muted); }

  details.risk > summary .chev {
    width: 8px; height: 8px;
    border-right: 1.5px solid var(--faint);
    border-bottom: 1.5px solid var(--faint);
    transform: rotate(45deg);
    margin-left: 0.3rem;
    transition: transform 0.15s;
  }

  details.risk[open] > summary .chev { transform: rotate(-135deg); }
  details.risk[open] > summary { border-bottom: 1px solid var(--border); }

  .risk-body { padding: 1.1rem 1.1rem 1.25rem; }

  .risk-statement {
    font-size: 13.5px;
    color: var(--text);
    border-left: 3px solid var(--red);
    padding: 0.1rem 0 0.1rem 0.8rem;
    margin-bottom: 1.1rem;
    line-height: 1.6;
  }

  .sub-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.45rem;
  }

  .evidence-text { font-size: 13.5px; color: var(--muted); line-height: 1.75; margin-bottom: 1.4rem; max-width: 760px; }

  .gap {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.8rem 0.9rem;
    margin-bottom: 0.6rem;
    background: var(--bg);
    scroll-margin-top: calc(var(--nav-h) + 12px);
  }

  .gap[hidden] { display: none; }
  .gap:target { border-color: var(--accent-mid); box-shadow: 0 0 0 2px var(--accent-light); }

  .gap-head { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 0.55rem; }
  .gap-id { font-family: var(--mono); font-size: 11.5px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .gap-id:hover { text-decoration: underline; }
  .gap-q { font-size: 14px; font-weight: 600; color: var(--text); flex: 1 1 320px; line-height: 1.45; }

  .task-list { list-style: none; display: grid; gap: 0.45rem; }

  .task {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
  }

  .task[hidden] { display: none; }
  .task .path { justify-self: start; margin-top: 1px; }
  .task .field-chip { margin-left: 0.3rem; }

  .gap-foot { margin-top: 0.55rem; font-size: 11.5px; }
  .gap-foot a { color: var(--faint); text-decoration: none; }
  .gap-foot a:hover { color: var(--accent-mid); text-decoration: underline; }

  /* ── PROPOSED FIELDS TABLE ── */
  .field-table td:first-child { font-family: var(--mono); font-size: 12px; color: var(--accent); white-space: nowrap; }
  .field-table td { font-size: 13px; color: var(--muted); vertical-align: top; }
  .field-table td a { font-family: var(--mono); font-size: 12px; margin-right: 0.4rem; }

  /* ── CONTRIBUTE ── */
  .contribute-box {
    background: var(--accent-light);
    border: 1px solid #c5d5ea;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
  }

  .contribute-box h3 { font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 0.5rem; }
  .contribute-box p { font-size: 13px; color: var(--accent); opacity: 0.9; line-height: 1.65; margin-bottom: 0.5rem; }
  .contribute-box p:last-child { margin-bottom: 0; }
  .contribute-box a { color: var(--accent); font-weight: 600; }

  /* ── REFERENCES ── */
  .references-section { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .references-section h2 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 0.75rem; }
  .references-section .method { font-size: 12px; color: var(--faint); line-height: 1.7; margin-bottom: 1rem; max-width: 760px; }
  .references-section ol { padding-left: 1.5rem; }
  .references-section li { font-size: 12px; color: var(--faint); line-height: 1.7; margin-bottom: 0.4rem; scroll-margin-top: calc(var(--nav-h) + 12px); }
  .references-section li:target { color: var(--text); background: var(--accent-light); }
  .references-section a { color: var(--accent-mid); text-decoration: none; }
  .references-section a:hover { text-decoration: underline; }

  .load-error { font-size: 13px; color: var(--red); background: var(--red-light); border-radius: 6px; padding: 0.75rem 1rem; }

  @media (max-width: 720px) {
    .structure { grid-template-columns: 1fr; }
    .structure-step:first-child { border-radius: 8px 8px 0 0; }
    .structure-step:last-child { border-radius: 0 0 8px 8px; }
    .structure-step + .structure-step { border-left: 1px solid var(--border); border-top: none; }
    .structure-step + .structure-step::before { left: 50%; top: -7px; transform: translateX(-50%) rotate(135deg); }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(3) { border-left: none; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--border); }
  }

  @media (max-width: 580px) {
    .rm-wrap { padding: 1.5rem 1rem 2.5rem; }
    details.risk > summary { grid-template-columns: 1fr auto; }
    details.risk > summary .code { grid-column: 1 / -1; }
    details.risk > summary .sum-meta { grid-column: 1 / -1; }
    .task { grid-template-columns: 1fr; gap: 0.25rem; }
    .key-box { grid-template-columns: 1fr; gap: 0.3rem; }
    .key-box .key-head { padding-top: 0.4rem; }
    .filter-count { margin-left: 0; width: 100%; }
  }
</style>
</head>
