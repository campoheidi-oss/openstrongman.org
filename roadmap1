    {
      "id": "CARD",
      "title": "Cardiovascular health",
      "statement": "Risk that extreme body mass, maximal straining efforts, and drug use produce cardiovascular disease or early death in strongman athletes.",
      "evidence": "none",
      "summary": "We found no study of heart structure, blood pressure, or cardiovascular outcomes in strongman athletes. The closest evidence comes from neighboring sports. Elite competitors in a five-year screening program averaged 152.9 kg and a BMI of 43.5, which puts them at the far edge of human body size {kraemer2020}. Powerlifters have thicker heart walls and higher blood pressure than distance runners, although the difference disappeared once heart mass was scaled to body size {silva2018}. Among 62 top Finnish powerlifters suspected of steroid use, the risk of death over 12 years was 4.6 times that of the general population, and heart attack was one of the leading causes {parssinen2000}. Long-term steroid users show weaker heart function and more coronary plaque than non-users {baggish2017}.",
      "gaps": [
        {
          "id": "CARD-1",
          "question": "What do the hearts of elite strongman competitors look like, structurally and functionally?",
          "status": "open",
          "tasks": [
            { "text": "Add echocardiography or cardiac MRI to the kind of competition health screening already used to collect body composition data.", "path": "external" }
          ]
        },
        {
          "id": "CARD-2",
          "question": "What are the long-term mortality and illness rates of former strongman competitors?",
          "status": "open",
