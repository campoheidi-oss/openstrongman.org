  "risks": [
    {
      "id": "INJ",
      "title": "Musculoskeletal injury",
      "statement": "Risk that strongman training and competition cause injuries at rates, body sites, or severities that have not been measured well enough to prevent them.",
      "evidence": "limited",
      "summary": "The only strongman-specific injury rates come from one retrospective survey of 213 athletes. In it, 82% reported an injury in the previous year, at 5.5 training injuries per 1,000 hours. The lower back (24%), shoulder (21%), biceps (11%), and knee (11%) were injured most often, and athletes were 1.9 times more likely to be hurt during implement training than during traditional lifting once exposure was accounted for {winwood2014}. A systematic review of the weight-training sports placed strongman (4.5 to 6.1 injuries per 1,000 hours) at the top of the range with Highland Games, and noted that only 4 of 20 studies used a prospective design {keogh2017}. Spine modeling found that the yoke carry produced the highest spinal loads of seven events tested, and that the atlas stone makes a neutral spine impossible {mcgill2009}. Beyond that, the evidence is case reports of biceps, rotator cuff, and triceps injuries {george2010} {lorenz2022} {hall2017}.",
      "gaps": [
        {
          "id": "INJ-1",
          "question": "What is the true incidence of injury in strongman when it is measured prospectively rather than recalled?",
          "status": "open",
          "tasks": [
            { "text": "Follow a cohort of competitive athletes through one or more seasons using a consensus injury definition and hours-based exposure.", "path": "external" }
          ]
        },
        {
